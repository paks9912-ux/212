<script>
(function(){
  var K=window.KYOTO, MENU=null, active="all";
  var $=function(id){return document.getElementById(id);};


  function renderList(){
    if(!MENU)return;
    var term=$("q").value.trim().toLowerCase();
    var items=MENU.items.filter(function(it){
      if(!it.available)return false;
      if(active!=="all"&&it.group!==active)return false;
      if(term&&it.name.toLowerCase().indexOf(term)===-1&&K.nameOf(it.name).toLowerCase().indexOf(term)===-1&&it.category.toLowerCase().indexOf(term)===-1)return false;
      return true;
    });
    $("total").textContent=items.length+" "+(K.lang()==="uz"?K.t("menu.dishes"):K.plural(items.length,"блюдо","блюда","блюд"))+
      (term?" — «"+$("q").value.trim()+"»":"");
    if(!items.length){
      $("list").innerHTML='<div class="empty"><b>'+K.t("menu.nothing")+'</b>'+K.t("menu.tryOther")+'</div>';
      return;
    }
    var html="";
    MENU.groups.forEach(function(g){
      var inG=items.filter(function(i){return i.group===g.id;});
      if(!inG.length)return;
      html+='<section class="group" id="g-'+g.id+'"><div class="group-head"><h2>'+K.esc(K.group(g.title))+'</h2></div>'+
        '<p class="group-count">'+inG.length+' '+(K.lang()==="uz"?K.t("menu.positions"):K.plural(inG.length,"позиция","позиции","позиций"))+'</p>';
      var cats=[];inG.forEach(function(i){if(cats.indexOf(i.category)===-1)cats.push(i.category);});
      cats.forEach(function(c){
        var rows=inG.filter(function(i){return i.category===c;});
        if(cats.length>1)html+='<div class="sub">'+K.esc(K.cat(c))+'</div>';
        html+='<div class="grid">'+rows.map(function(i){return K.cardHTML(i);}).join("")+'</div>';
      });
      html+='</section>';
    });
    $("list").innerHTML=html;
  }

  function renderChips(){
    if(!MENU)return;
    var c='<button class="chip'+(active==="all"?" on":"")+'" data-g="all">'+K.t("menu.all")+' <b>'+MENU.items.length+'</b></button>';
    MENU.groups.forEach(function(g){
      if(!g.count)return;
      c+='<button class="chip'+(active===g.id?" on":"")+'" data-g="'+g.id+'">'+
         K.esc(K.group(g.title))+' <b>'+g.count+'</b></button>';
    });
    $("chips").innerHTML=c;

    // Кнопка поиска живёт в липкой полосе рядом с чипсами: на телефоне
    // шапка с полем поиска уезжает вместе со страницей, а искать в 158
    // позициях надо. Сама кнопка — в разметке, вне прокрутки чипсов,
    // иначе чипсы проезжали бы под ней.
    var ns=$("navSearch");
    if(ns)ns.setAttribute("aria-label",K.t("search.aria"));
    if(ns)ns.onclick=function(){
      var input=$("q");
      if(!input)return;
      // Возвращаем шапку в поле зрения и ставим курсор в поиск
      window.scrollTo({top:0,behavior:"smooth"});
      setTimeout(function(){ input.focus(); }, 320);
    };

    renderSide();
  }

  // Разделы в выезжающей панели — её открывает бургер в шапке
  function renderSide(){
    var side=$("sdBody");
    if(!side||!MENU)return;
    var h='<button class="sd-item'+(active==="all"?" on":"")+'" data-g="all">'+
          K.t("menu.all")+
          '<span class="sd-n">'+MENU.items.length+'</span></button>';
    MENU.groups.forEach(function(g){
      if(!g.count)return;
      h+='<button class="sd-item'+(active===g.id?" on":"")+'" data-g="'+g.id+'">'+
         K.esc(K.group(g.title))+
         '<span class="sd-n">'+g.count+'</span></button>';
    });
    side.innerHTML=h;
  }

  // Выбор раздела — из чипсов или из бокового списка
  function pickGroup(id){
    active=id;
    // Какой раздел открыли — в аналитику поведения
    try{
      var g=(MENU&&MENU.groups||[]).filter(function(x){return x.id===id})[0];
      if(g&&K.ev)K.ev("cat",g.title,"открыл раздел: "+g.title);
    }catch(e){}
    renderChips();
    renderList();
    window.scrollTo({top:0,behavior:"smooth"});
  }

  // Пришли на страницу раздела (/menu/sushi) — сразу открываем его
  var fromPath=document.body.dataset.group;
  if(fromPath)active=fromPath;

  K.init(function(menu){
    MENU=menu;
    renderChips();
    $("chips").addEventListener("click",function(e){
      var b=e.target.closest(".chip");
      if(b)pickGroup(b.dataset.g);
    });
    $("sdBody").addEventListener("click",function(e){
      var b=e.target.closest(".sd-item");
      if(b){ K.closeSide(); pickGroup(b.dataset.g); }
    });
    renderList();

    // Кнопка «Смотреть сеты» — обычный якорь href="#g-sets", без
    // скрипта: у карточек задан aspect-ratio, высота не пляшет от
    // ленивых фото, а отступ под шапку берётся из scroll-margin-top
    // у .group. Родной переход браузера тут надёжнее обработчика.

    // Прямой переход на раздел: /menu.html#g-sets
    // Пробуем несколько раз: карточки грузят фото, и высота страницы
    // растёт уже после первой отрисовки — одиночный прыжок промахивался
    // и человек оставался наверху меню.
    if(location.hash){
      var hash=location.hash;
      var jump=function(){
        var target=document.querySelector(hash);
        if(!target)return false;
        var y=target.getBoundingClientRect().top+window.scrollY-70;
        window.scrollTo(0,Math.max(0,y));
        return true;
      };
      [60,400,1200,2500].forEach(function(ms){ setTimeout(jump,ms); });
      window.addEventListener("load",function(){ setTimeout(jump,300); });
    }
  }).catch(function(){
    $("list").innerHTML='<div class="empty"><b>'+K.t("err.serverDown")+'</b>'+K.t("err.serverHint")+'</div>';
  });

  // Запрос из адресной строки: /menu.html?q=филадельфия (поиск с главной)
  var fromUrl=new URLSearchParams(location.search).get("q");
  if(fromUrl){$("q").value=fromUrl;}

  var st;
  $("q").addEventListener("input",function(){clearTimeout(st);st=setTimeout(renderList,120);});
  $("list").addEventListener("click",K.clickQty);
  K.onChange(renderList);
  // Смена языка — перерисовываем и разделы, и список
  if(window.I18N) window.I18N.onChange(function(){ renderChips(); renderList(); });
})();
</script>
