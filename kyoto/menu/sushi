<style>
/* Фон берём из темы: раньше был захардкожен светлым и в тёмной теме
   полоса категорий светилась белым.
   top равен высоте шапки (78px) — иначе полоса наезжает на неё. */
/* Шапка уезжает, липнет только полоса категорий — 56 пикселей вместо
   134. Корзина остаётся доступной: её полоса всплывает снизу. */
.top-main{position:static}
.nav{position:sticky;top:0;z-index:55;background:var(--top-bg);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border)}
/* На телефоне шапка не липнет: вдвоём с полосой они съедали бы
   четверть экрана. Липкой остаётся ПОЛОСА КАТЕГОРИЙ — человек всегда
   видит, в каком разделе. Корзина при этом не теряется: внизу живёт
   липкая полоса корзины, а поиск переехал прямо сюда, к чипсам. */
@media (max-width:700px){
  .top-main{position:static}
  .nav{top:0}
  .group{scroll-margin-top:90px}
}
.nav-in{display:flex;gap:8px;overflow-x:auto;padding:12px 22px;max-width:var(--maxw);margin:0 auto;scrollbar-width:none}
/* Место под кнопку поиска, прижатую к правому краю полосы.
   Строго ПОСЛЕ .nav-in: сокращение padding выше перебило бы отступ. */
@media (max-width:700px){ .nav-in{padding-right:70px} }
.nav-in::-webkit-scrollbar{display:none}
/* Чипсы — заливка без рамок, как всё остальное */
.chip{white-space:nowrap;padding:11px 18px;border-radius:100px;font-size:14px;font-weight:500;
  border:1px solid transparent;background:var(--surface-2);color:var(--text-2);
  transition:background .15s,color .15s;display:flex;align-items:center;gap:7px}
.chip:hover{background:var(--border);color:var(--text)}
.chip.on{background:var(--shu);color:#fff;font-weight:600}
.chip b{font-weight:inherit;opacity:.6;font-size:12.5px}
.head{padding:32px 0 6px}
.head h1{font-size:clamp(26px,3.3vw,36px);font-weight:700;margin-bottom:7px}
.head p{color:var(--text-2);margin:0;font-size:15px}
.group{padding:32px 0 6px;scroll-margin-top:150px}
.group-head{display:flex;align-items:center;gap:12px;margin-bottom:4px}
.group-head h2{font-size:clamp(20px,2.4vw,27px);font-weight:700}
.group-count{color:var(--text-2);font-size:14px;margin:0 0 18px}
.sub{font-size:12.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-2);
  margin:26px 0 14px}

/* Телефон: до правки над первым блюдом стояли три заголовка подряд
   («Меню» → «Роллы и суши» → «Гункан-суши») и съедали 264 пикселя из
   812 — треть первого экрана уходила на текст, а не на еду.
   Заголовки остаются все (они нужны и человеку, и поиску), но дышат
   заметно теснее. */
@media (max-width:700px){
  .head{padding:18px 0 2px}
  .head h1{font-size:24px;margin-bottom:3px}
  .head p{font-size:13.5px}
  .group{padding:20px 0 4px}
  .group-head{gap:9px;margin-bottom:2px}
  .group-count{font-size:13px;margin:0 0 12px}
  .sub{margin:18px 0 10px}
}

/* Разделы переехали в выезжающую панель (бургер в шапке) — каталогу
   досталась вся ширина, полоса чипсов на десктопе больше не нужна */
@media (min-width:1100px){
  /* Разделы на широком экране живут в выезжающей панели, полоса
     категорий не нужна. Но тогда липнуть сверху нечему — возвращаем
     шапке фиксацию, иначе при прокрутке верх остаётся пустым и до
     корзины с поиском не добраться. */
  .nav{display:none}
  .top-main{position:sticky;top:0}
  .group{scroll-margin-top:100px}
}

</style>
