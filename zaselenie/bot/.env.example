# Токен у @BotFather → /newbot. Обязателен.
TELEGRAM_BOT_TOKEN=123456789:AA...

# Куда падают эскалации: ваш chat id или id группы менеджеров (у групп минус впереди).
# Свой id узнать: написать боту и посмотреть в логе «chat 123456789».
MANAGER_CHAT_ID=

# Пусто — бот отвечает текстами движка (это рабочий режим, не заглушка).
# С ключом — движок считает факты, а Claude формулирует ответ живым языком.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# polling — ничего наружу не нужно, работает даже с домашнего компьютера.
# webhook — нужен домен с https и открытый порт.
BOT_MODE=polling
WEBHOOK_URL=https://bot.example.com/telegram
WEBHOOK_SECRET=
PORT=8080

# Сколько часов помним диалог и сколько сообщений в минуту принимаем от одного чата.
SESSION_TTL_HOURS=48
RATE_LIMIT=20
