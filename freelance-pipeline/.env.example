# Скопируйте в .env и заполните. В git этот файл не попадает.

# Claude — обязательно
ANTHROPIC_API_KEY=

# Telegram-бот (алерты и команды) — обязательно для режима bot/daemon
# Токен от @BotFather; ваш chat id — от @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Чтение публичных Telegram-каналов — необязательно
# api_id и api_hash с https://my.telegram.org, сессия — из npm run tg:login
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# Freelancer.com — необязательно
# Токен OAuth с https://www.freelancer.com/developers
FREELANCER_TOKEN=

# Веб-панель: адрес и порт. По умолчанию слушает только localhost
WEB_HOST=127.0.0.1
WEB_PORT=8787

# Путь к базе
DB_PATH=./data/app.db
